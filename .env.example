# Server-only values. Never prefix database credentials with NEXT_PUBLIC_.
IMPACT_DATABASE_URL=postgresql://restricted_role:password@host/neondb?sslmode=require
# Operator CLI only; do not set this privileged URL on the public app host.
IMPACT_ADMIN_DATABASE_URL=postgresql://owner:password@host/neondb?sslmode=require
IMPACT_ENABLED=false
IMPACT_PRIVACY_EMAIL=privacy@example.com
# Set to the exact HTTPS site origin when deployed.
IMPACT_APP_ORIGIN=

# RN3 writing help. Keep false until restricted AI budget storage and evaluation are ready.
PONDROOT_AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_DATABASE_URL=postgresql://pondroot_ai_app:password@host/neondb?sslmode=require
PONDROOT_AI_APP_ORIGIN=
